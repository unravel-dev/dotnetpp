<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Driven by CMake (CLRPP_DOTNET_VERSION) via -p:ClrppDotnetVersion;
         the value here is the fallback for standalone builds. -->
    <ClrppDotnetVersion Condition="'$(ClrppDotnetVersion)' == ''">9.0</ClrppDotnetVersion>
    <TargetFramework>net$(ClrppDotnetVersion)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>Clrpp.Managed</AssemblyName>
    <RootNamespace>Clrpp</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Configuration>Release</Configuration>
    <Configurations>Release</Configurations>
    <Optimize>true</Optimize>
    <!-- NuGet dependencies (Mono.Cecil) must land next to the bridge dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <!-- The framework reference assemblies of the target framework, beside the bridge in
       ref/<tfm>: native script compiles reference these, so the script API surface is the
       target framework's whatever SDK is installed (an SDK of a newer major restores them
       from NuGet). -->
  <Target Name="CopyFrameworkReferenceAssemblies" AfterTargets="Build">
    <ItemGroup>
      <ClrppFrameworkReference Include="@(ReferencePath)"
                               Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Copy SourceFiles="@(ClrppFrameworkReference)"
          DestinationFolder="$(OutDir)ref/$(TargetFramework)"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PrintCompilerInfo" BeforeTargets="CoreCompile">
    <Message Importance="high"
            Text="TargetFramework=$(TargetFramework)" />
    <Message Importance="high"
            Text="NETCoreSdkVersion=$(NETCoreSdkVersion)" />
    <Message Importance="high"
            Text="LangVersion=$(LangVersion)" />
  </Target>
  <ItemGroup>
    <!-- Icall IL weaving as a compile step (see Weaver.cs). Standalone IL
         library, no dependency on the mono runtime. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- Optional leak diagnostics (see Bridge.LeakAnalysis.cs). ClrMD lets us
         snapshot our own process and walk the real GC handle table / heap /
         root paths - only exercised when a domain failed to unload. -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
  </ItemGroup>

</Project>
